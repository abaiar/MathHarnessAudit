{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:math-harness-audit:schema:qualification-publication-data:0.1",
  "title": "MathHarnessAudit qualification publication data identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "tool_version",
    "source_plan_sha256",
    "analysis_config_raw_sha256",
    "label_variants",
    "analysis_inputs",
    "table_row_counts",
    "primary_figure_label_variant",
    "system_ranking_computed",
    "data_sha256"
  ],
  "properties": {
    "format": {"const": "mathaudit-qualification-publication-data-v0.1"},
    "tool_version": {"type": "string", "minLength": 1},
    "source_plan_sha256": {"$ref": "#/$defs/hash"},
    "analysis_config_raw_sha256": {"$ref": "#/$defs/hash"},
    "label_variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "contains": {"const": "deterministic"},
      "items": {"enum": ["deterministic", "adjudicated"]}
    },
    "analysis_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/input"}
    },
    "table_row_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "cost",
        "exact_pairwise",
        "source_type_pairwise",
        "cofailure",
        "transitions",
        "utilization",
        "text_repetition",
        "effective_support",
        "final_outcomes"
      ],
      "properties": {
        "availability": {"type": "integer", "minimum": 0},
        "cost": {"type": "integer", "minimum": 0},
        "exact_pairwise": {"type": "integer", "minimum": 0},
        "source_type_pairwise": {"type": "integer", "minimum": 0},
        "cofailure": {"type": "integer", "minimum": 0},
        "transitions": {"type": "integer", "minimum": 0},
        "utilization": {"type": "integer", "minimum": 0},
        "text_repetition": {"type": "integer", "minimum": 0},
        "effective_support": {"type": "integer", "minimum": 0},
        "final_outcomes": {"type": "integer", "minimum": 0}
      }
    },
    "primary_figure_label_variant": {"enum": ["deterministic", "adjudicated"]},
    "system_ranking_computed": {"const": false},
    "data_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label_variant", "analysis_sha256", "raw_sha256"],
      "properties": {
        "label_variant": {"enum": ["deterministic", "adjudicated"]},
        "analysis_sha256": {"$ref": "#/$defs/hash"},
        "raw_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
