{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:math-harness-audit:schema:source-fingerprint:0.1",
  "title": "MathHarnessAudit source-tree fingerprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "system_id",
    "algorithm",
    "root_hint",
    "excluded_paths",
    "excluded_directories",
    "file_count",
    "manifest_sha256",
    "files",
    "self_sha256"
  ],
  "properties": {
    "format": {"const": "mathaudit-source-fingerprint-v0.1"},
    "system_id": {"type": "string", "minLength": 1},
    "algorithm": {"const": "sha256-lines-posix-path-utf8-byte-sort-v1"},
    "root_hint": {"type": "string", "minLength": 1},
    "excluded_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "excluded_directories": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "file_count": {"type": "integer", "minimum": 1},
    "manifest_sha256": {"$ref": "#/$defs/hash"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^[^/].*"},
          "sha256": {"$ref": "#/$defs/hash"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "self_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
