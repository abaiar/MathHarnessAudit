{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:math-harness-audit:schema:qualification-forecast:0.1",
  "title": "MathHarnessAudit outcome-blind qualification resource forecast",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "authorization_id",
    "qualification_health_sha256",
    "outcome_blind",
    "correctness_aggregates_computed",
    "basis",
    "scenarios",
    "interpretation_constraints",
    "forecast_sha256"
  ],
  "properties": {
    "format": {"const": "mathaudit-qualification-forecast-v0.1"},
    "authorization_id": {"type": "string", "minLength": 1},
    "qualification_health_sha256": {"$ref": "#/$defs/hash"},
    "outcome_blind": {"const": true},
    "correctness_aggregates_computed": {"const": false},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered_qualification_tasks",
        "attempted_episodes",
        "complete_full_trace_episodes",
        "linear_extrapolation"
      ],
      "properties": {
        "registered_qualification_tasks": {"const": 50},
        "attempted_episodes": {"type": "integer", "minimum": 0, "maximum": 150},
        "complete_full_trace_episodes": {"type": "integer", "minimum": 0, "maximum": 150},
        "linear_extrapolation": {"const": true}
      }
    },
    "scenarios": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/scenario"}
    },
    "interpretation_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "forecast_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_number": {"type": ["number", "null"], "minimum": 0},
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projected_episodes",
        "projected_request_count",
        "projected_reserved_token_upper",
        "projected_observed_token_point",
        "observed_usage_fraction",
        "projected_summed_wall_time_s",
        "projected_summed_wall_time_h"
      ],
      "properties": {
        "projected_episodes": {"type": "integer", "minimum": 1},
        "projected_request_count": {"type": "number", "minimum": 0},
        "projected_reserved_token_upper": {"type": "number", "minimum": 0},
        "projected_observed_token_point": {"$ref": "#/$defs/nullable_number"},
        "observed_usage_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "projected_summed_wall_time_s": {"type": "number", "minimum": 0},
        "projected_summed_wall_time_h": {"type": "number", "minimum": 0}
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projected_request_count",
        "projected_reserved_token_upper",
        "projected_observed_token_point",
        "projected_summed_wall_time_s",
        "projected_summed_wall_time_h"
      ],
      "properties": {
        "projected_request_count": {"type": "number", "minimum": 0},
        "projected_reserved_token_upper": {"type": "number", "minimum": 0},
        "projected_observed_token_point": {"$ref": "#/$defs/nullable_number"},
        "projected_summed_wall_time_s": {"type": "number", "minimum": 0},
        "projected_summed_wall_time_h": {"type": "number", "minimum": 0}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_count", "total_system_episodes", "systems", "totals"],
      "properties": {
        "task_count": {"type": "integer", "minimum": 1},
        "total_system_episodes": {"type": "integer", "minimum": 3},
        "systems": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mathrouter", "icma", "mathgoal"],
          "properties": {
            "mathrouter": {"$ref": "#/$defs/system"},
            "icma": {"$ref": "#/$defs/system"},
            "mathgoal": {"$ref": "#/$defs/system"}
          }
        },
        "totals": {"$ref": "#/$defs/totals"}
      }
    }
  }
}
